@host = https://localhost:7154
@token = COLE_O_TOKEN_AQUI

### Registrar
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "Raiã",
  "email": "raia@example.com",
  "password": "senha-forte-123"
}

### Login
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "raia@example.com",
  "password": "senha-forte-123"
}

### Perfil
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{token}}

### Criar conta
POST {{host}}/api/v1/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nubank",
  "type": "Checking",
  "currency": "BRL"
}

### Listar categorias
GET {{host}}/api/v1/categories
Authorization: Bearer {{token}}

### Lançar transação (categorizada automaticamente)
POST {{host}}/api/v1/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "accountId": "COLE_O_ID_DA_CONTA",
  "type": "Expense",
  "amount": 23.90,
  "description": "UBER *TRIP",
  "occurredAt": "2026-09-18"
}

### Buscar transações
GET {{host}}/api/v1/transactions?from=2026-09-01&to=2026-09-30&page=1&pageSize=20
Authorization: Bearer {{token}}

### Definir orçamento
PUT {{host}}/api/v1/budgets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": "COLE_O_ID_DA_CATEGORIA",
  "period": "2026-09",
  "limit": 500
}

### Dashboard
GET {{host}}/api/v1/dashboard/summary?period=2026-09
Authorization: Bearer {{token}}

### Alertas em tempo real (SSE)
GET {{host}}/api/v1/events/budget-alerts
Authorization: Bearer {{token}}
Accept: text/event-stream
